# Server-only values. Copy the placeholders into .env.local without overwriting
# unrelated settings. Also add them to Vercel for the intended environment.
APP_URL=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Google/GitHub secrets and Brevo SMTP credentials belong in the Supabase
# dashboard, not here. No NEXT_PUBLIC secret variables are needed.
